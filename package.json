{
  "name": "@gsainfoteam/nest-observability",
  "version": "0.0.7",
  "description": "NestJS observability toolkit",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "private": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target node -e @prisma/instrumentation && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "bun test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "peerDependencies": {
    "@nestjs/common": "^10 || ^11",
    "@nestjs/core": "^10 || ^11",
    "@prisma/client": "^5 || ^6 || ^7",
    "@prisma/instrumentation": "^5 || ^6 || ^7"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
